# Copy to `.env` (never commit `.env`). Values below match the local Docker
# Compose defaults in ../../compose.yaml and are for local development only.

# Where pages read data from:
#   fixtures  — built-in fictional demo data (default; used by e2e tests)
#   database  — PostgreSQL via Prisma (requires DATABASE_URL)
PROREZ_DATA_SOURCE=fixtures

# Development database (docker compose up -d --wait).
DATABASE_URL="postgresql://prorez:prorez_local_dev@127.0.0.1:5433/prorez_dev"

# Saving profiles and boards (database mode only). Fails closed: anything other
# than "enabled" keeps the app read-only. Changes are also accepted only from
# localhost; `npm run dev` / `npm start` bind to 127.0.0.1. Replace this with real
# authentication before exposing ProRez on any network.
PROREZ_LOCAL_MUTATIONS=enabled

# Separate database for `npm run test:db`. Its name MUST end in `_test`;
# the test setup drops and recreates its schema on every run.
TEST_DATABASE_URL="postgresql://prorez:prorez_local_dev@127.0.0.1:5433/prorez_test"

# Separate database for `npm run test:e2e:db` (name MUST end in `_e2e`; created
# automatically and reset on every run).
E2E_DATABASE_URL="postgresql://prorez:prorez_local_dev@127.0.0.1:5433/prorez_e2e"

# The demo seed only runs against local hosts. Set to 1 only for a remote
# NON-production database you are sure may receive fictional data.
# PROREZ_ALLOW_REMOTE_DEMO_SEED=0
