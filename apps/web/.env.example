# Copy to `.env` (never commit `.env`). Values below match the local Docker
# Compose defaults in ../../compose.yaml and are for local development only.

# Where pages read data from:
#   fixtures  — built-in fictional demo data (default; used by e2e tests)
#   database  — PostgreSQL via Prisma (requires DATABASE_URL)
PROREZ_DATA_SOURCE=fixtures

# Development database (docker compose up -d --wait).
DATABASE_URL="postgresql://prorez:prorez_local_dev@127.0.0.1:5433/prorez_dev"

# Saving profiles and boards (database mode only). Fails closed: anything other
# than "enabled" keeps the app read-only. Changes are also accepted only from
# localhost; `npm run dev` / `npm start` bind to 127.0.0.1. Replace this with real
# authentication before exposing ProRez on any network.
PROREZ_LOCAL_MUTATIONS=enabled

# Separate database for `npm run test:db`. Its name MUST end in `_test`;
# the test setup drops and recreates its schema on every run.
TEST_DATABASE_URL="postgresql://prorez:prorez_local_dev@127.0.0.1:5433/prorez_test"

# Separate database for `npm run test:e2e:db` (name MUST end in `_e2e`; created
# automatically and reset on every run).
E2E_DATABASE_URL="postgresql://prorez:prorez_local_dev@127.0.0.1:5433/prorez_e2e"

# The demo seed only runs against local hosts. Set to 1 only for a remote
# NON-production database you are sure may receive fictional data.
# PROREZ_ALLOW_REMOTE_DEMO_SEED=0

# Background board-sync worker (npm run worker). Defaults shown; see docs/ats-sync.md.
# PROREZ_WORKER_CONCURRENCY=3
# PROREZ_WORKER_PROVIDER_CONCURRENCY=1
# PROREZ_WORKER_POLL_SECONDS=30
# PROREZ_WORKER_LEASE_MINUTES=10
# PROREZ_SYNC_MAX_RETRIES=3
# PROREZ_SYNC_RETRY_BASE_MINUTES=5

# Automatic board discovery (docs/discovery.md). Tavily is the default and its
# free Researcher allowance does not require billing information.
# PROREZ_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# Optional legacy provider: set PROREZ_SEARCH_PROVIDER=brave and provide:
# BRAVE_SEARCH_API_KEY=
# PROREZ_DISCOVERY_ENABLED=false
# PROREZ_DISCOVERY_INTERVAL_HOURS=24
# PROREZ_DISCOVERY_MAX_QUERIES_PER_RUN=10
# PROREZ_DISCOVERY_MAX_REQUESTS_PER_DAY=30
# PROREZ_DISCOVERY_MAX_CREDITS_PER_MONTH=900
# PROREZ_DISCOVERY_MAX_CANDIDATES_PER_RUN=25
# PROREZ_DISCOVERY_AUTO_REGISTER=true

# Workday and company career sites (Milestone 3D, docs/career-sources.md). Defaults shown.
# PROREZ_WORKDAY_MAX_LISTING_PAGES=100   # pages of 20 postings; beyond this a snapshot is incomplete
# PROREZ_WORKDAY_MAX_DETAILS=60          # job-detail requests per sync (descriptions; never affects completeness)
# PROREZ_WORKDAY_MIN_INTERVAL_MS=250     # pause between requests to one Workday site
# PROREZ_GENERIC_MAX_LISTING_PAGES=5
# PROREZ_GENERIC_MAX_JOB_PAGES=40
# PROREZ_GENERIC_MAX_RENDERS=3
# PROREZ_GENERIC_MIN_INTERVAL_MS=1000    # per-host politeness for company websites
# Optional browser rendering for JavaScript-only career pages (worker only;
# never in the web server). Requires: npx playwright install chromium
# PROREZ_RENDER_ENABLED=false
# PROREZ_RENDER_TIMEOUT_SECONDS=20
# PROREZ_RENDER_MAX_REQUESTS=150
# PROREZ_RENDER_CONCURRENCY=1
