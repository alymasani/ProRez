// ProRez persistence model (Milestones 2A–2C).
//
// Design notes
// - `job_postings` is the canonical, deduplicated job. Each place a job was seen
//   (ATS board, manual entry) is a `source_observations` row pointing at it.
// - Discovery, preparation, and submission are separate columns/enums and must
//   never be merged.
// - Constraints Prisma cannot express (CHECK constraints, partial unique
//   indexes) live in the migration SQL; see prisma/migrations/*_init.
// - `is_demo` marks development fixtures. The seed refuses to run against
//   production; see lib/db/seed-guard.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared vocabularies (values match lib/types.ts)
// ---------------------------------------------------------------------------

enum Province {
  AB
  BC
  MB
  NB
  NL
  NS
  NT
  NU
  ON
  PE
  QC
  SK
  YT

  @@map("province")
}

enum WorkArrangement {
  onsite
  hybrid
  remote

  @@map("work_arrangement")
}

enum JobType {
  new_grad
  junior
  internship
  co_op

  @@map("job_type")
}

enum Discipline {
  backend
  frontend
  full_stack
  mobile
  infrastructure
  data
  machine_learning
  embedded
  security
  qa_automation

  @@map("discipline")
}

/// Internship / co-op duration requirements for profiles and default settings
/// (Milestone 2C; replaces the ambiguous 2A buckets). "4_to_8" is not a valid
/// identifier, so the repository maps it (lib/repositories/prisma-mappers.ts).
/// legacy_* values only exist on profiles migrated from the old buckets and
/// keep their previous behaviour exactly; they cannot be newly selected.
enum DurationRequirement {
  exactly_4
  up_to_4
  months_4_to_8 @map("4_to_8")
  any
  unspecified
  legacy_5_to_8
  legacy_over_8

  @@map("duration_requirement")
}

enum ExperienceLevel {
  student
  new_grad
  junior

  @@map("experience_level")
}

enum ApplicationMode {
  quick_apply
  full_build

  @@map("application_mode")
}

// ---------------------------------------------------------------------------
// Sources & canonical jobs
// ---------------------------------------------------------------------------

enum SourceProvider {
  greenhouse
  lever
  ashby
  smartrecruiters
  company_site
  manual

  @@map("source_provider")
}

enum SourceIntegrationStatus {
  planned
  not_configured
  connected
  error

  @@map("source_integration_status")
}

/// Discovery lifecycle (independent of preparation and submission).
enum DiscoveryStatus {
  discovered
  saved
  dismissed
  expired

  @@map("discovery_status")
}

/// How a job entered ProRez.
enum JobOrigin {
  manual
  automatic

  @@map("job_origin")
}

enum SalaryCurrency {
  CAD
  USD

  @@map("salary_currency")
}

enum SalaryPeriod {
  hour
  month
  year

  @@map("salary_period")
}

enum DescriptionSource {
  manual_submission
  manual_edit
  source_import

  @@map("description_source")
}

enum JobEventType {
  created
  sighting_added
  discovery_status_changed
  details_updated
  notes_updated
  description_added
  evaluation_changed

  @@map("job_event_type")
}

model JobSource {
  id                String                  @id
  provider          SourceProvider          @unique
  label             String
  description       String
  enabled           Boolean                 @default(false)
  integrationStatus SourceIntegrationStatus @default(planned) @map("integration_status")
  lastCheckedAt     DateTime?               @map("last_checked_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  observations SourceObservation[]
  boards       EmployerBoard[]

  @@map("job_sources")
}

/// Canonical job record. One row per real-world posting regardless of how many
/// sources reported it.
model JobPosting {
  id                    String          @id
  /// Normalized identity (company|title|location) used to merge observations.
  dedupeKey             String          @unique @map("dedupe_key")
  company               String
  title                 String
  jobType               JobType         @map("job_type")
  durationMonths        Int?            @map("duration_months")
  term                  String?
  disciplines           Discipline[]
  summary               String          @default("")
  responsibilities      String[]
  qualifications        String[]
  /// Preferred link to the posting (usually from the primary observation).
  postingUrl            String?         @map("posting_url")
  postedAt              DateTime?       @map("posted_at") @db.Timestamptz(3)
  firstDiscoveredAt     DateTime        @map("first_discovered_at") @db.Timestamptz(3)
  discoveryStatus       DiscoveryStatus @default(discovered) @map("discovery_status")
  origin                JobOrigin       @default(automatic)
  /// Bumped on every edit to job details (not on status changes); optimistic concurrency.
  version               Int             @default(1)
  /// Current full description text (untrusted; always rendered as plain text).
  /// The original is preserved immutably in job_description_snapshots.
  description           String?
  experienceRequirement String?         @map("experience_requirement")
  /// CHECK constraints keep salary fields consistent (see migration SQL).
  salaryMin             Int?            @map("salary_min")
  salaryMax             Int?            @map("salary_max")
  salaryCurrency        SalaryCurrency? @map("salary_currency")
  salaryPeriod          SalaryPeriod?   @map("salary_period")
  notes                 String          @default("")
  /// Primary source for display; every sighting is in `observations`.
  primarySourceId       String?         @map("primary_source_id")
  isDemo                Boolean         @default(false) @map("is_demo")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations            JobLocation[]
  observations         SourceObservation[]
  match                JobMatch?
  profileEvaluation    JobProfileEvaluation?
  application          Application?
  approvals            ApprovalRequest[]
  resumes              ResumeArtifact[]
  coverLetters         CoverLetterArtifact[]
  projectLinks         ProjectJob[]
  descriptionSnapshots JobDescriptionSnapshot[]
  events               JobEvent[]

  @@index([discoveryStatus])
  @@index([origin])
  @@index([firstDiscoveredAt(sort: Desc)])
  @@index([jobType])
  @@map("job_postings")
}

model JobLocation {
  id          String          @id @default(uuid()) @db.Uuid
  jobId       String          @map("job_id")
  /// Display order; 0 is the primary location.
  position    Int
  city        String
  /// Null only for remote roles open anywhere in Canada (CHECK in migration SQL).
  province    Province?
  arrangement WorkArrangement
  /// False when the source did not state the arrangement (matching: unknown).
  arrangementStated Boolean @default(true) @map("arrangement_stated")

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@index([province])
  @@map("job_locations")
}

/// One sighting of a canonical job on one source.
model SourceObservation {
  id                  String          @id @default(uuid()) @db.Uuid
  jobId               String          @map("job_id")
  sourceId            String          @map("source_id")
  /// Employer board the sighting came from (null for manual entries).
  boardId             String?         @map("board_id") @db.Uuid
  /// The source's own identifier (null for manual entries).
  externalId          String?         @map("external_id")
  /// URL exactly as submitted or reported (never fetched).
  sourceUrl           String?         @map("source_url")
  /// Normalized URL for duplicate detection (lib/jobs/url.ts). One job per URL.
  canonicalUrl        String?         @unique @map("canonical_url")
  /// ATS posting identity parsed from the URL, when recognisable. All three or none.
  atsProvider         SourceProvider? @map("ats_provider")
  atsBoardToken       String?         @map("ats_board_token")
  atsPostingId        String?         @map("ats_posting_id")
  rawTitle            String?         @map("raw_title")
  /// Original payload for audit / re-parsing. Never rendered directly.
  payload             Json?
  /// Publication time reported by the provider, and what that field actually means.
  providerPublishedAt DateTime?       @map("provider_published_at") @db.Timestamptz(3)
  publishedAtKind     PublishedAtKind @default(none) @map("published_at_kind")
  /// SHA-256 of the normalized posting; a change means the posting materially changed.
  contentHash         String?         @map("content_hash")
  /// Inactivation time: set after the posting is absent from two consecutive
  /// complete, successful board syncs. Null = active.
  closedAt            DateTime?       @map("closed_at") @db.Timestamptz(3)
  /// Consecutive complete snapshots in which the posting was absent.
  missingCount        Int             @default(0) @map("missing_count")
  firstSeenAt         DateTime        @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt          DateTime        @map("last_seen_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  job    JobPosting     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source JobSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  board  EmployerBoard? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@unique([atsProvider, atsBoardToken, atsPostingId])
  @@index([jobId])
  @@index([boardId])
  @@map("source_observations")
}

/// Immutable copy of a job description as it was captured. The first row per
/// job is the original; edits append new rows. A trigger rejects UPDATEs.
model JobDescriptionSnapshot {
  id          String            @id @default(uuid()) @db.Uuid
  jobId       String            @map("job_id")
  content     String
  /// SHA-256 (hex) of `content`.
  contentHash String            @map("content_hash")
  source      DescriptionSource
  capturedAt  DateTime          @default(now()) @map("captured_at") @db.Timestamptz(3)
  isDemo      Boolean           @default(false) @map("is_demo")

  /// Restrict: a job with captured descriptions cannot be hard-deleted.
  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, contentHash])
  @@index([jobId, capturedAt])
  @@map("job_description_snapshots")
}

/// Append-only history for a job (status changes, edits, sightings, matching changes).
model JobEvent {
  id         String       @id @default(uuid()) @db.Uuid
  jobId      String       @map("job_id")
  type       JobEventType
  fromValue  String?      @map("from_value")
  toValue    String?      @map("to_value")
  message    String?
  /// Structured detail, e.g. the profile matches before/after an evaluation change.
  data       Json?
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  isDemo     Boolean      @default(false) @map("is_demo")

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, occurredAt])
  @@map("job_events")
}

/// Candidate-fit result for a job (one current score per job).
model JobMatch {
  jobId         String   @id @map("job_id")
  /// 0–100, enforced by CHECK constraint in the migration.
  fitScore      Int      @map("fit_score")
  matchedSkills String[] @map("matched_skills")
  missingSkills String[] @map("missing_skills")
  reasons       String[]
  computedAt    DateTime @map("computed_at") @db.Timestamptz(3)
  isDemo        Boolean  @default(false) @map("is_demo")

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([fitScore(sort: Desc)])
  @@map("job_matches")
}

// ---------------------------------------------------------------------------
// Search profiles
// ---------------------------------------------------------------------------

enum ProfileMatchStatus {
  eligible
  needs_review

  @@map("profile_match_status")
}

enum AutomationMode {
  approval_required
  quick_generate
  notify_only

  @@map("automation_mode")
}

enum NotificationChannel {
  telegram

  @@map("notification_channel")
}

enum NotificationCadence {
  immediate
  daily_digest

  @@map("notification_cadence")
}

/// Name uniqueness is case-insensitive among NON-archived profiles: a partial
/// unique index in the migration SQL (Prisma cannot express it).
model SearchProfile {
  id                     String              @id
  /// Current version; bumped on every saved change (optimistic concurrency).
  version                Int                 @default(1)
  /// Profiles with match history are archived instead of deleted.
  archivedAt             DateTime?           @map("archived_at") @db.Timestamptz(3)
  name                   String
  description            String              @default("")
  enabled                Boolean             @default(true)
  /// 0–100, enforced by CHECK constraint in the migration.
  minFitScore            Int                 @default(70) @map("min_fit_score")
  automationMode         AutomationMode      @default(approval_required) @map("automation_mode")
  notificationsEnabled   Boolean             @default(true) @map("notifications_enabled")
  notificationChannel    NotificationChannel @default(telegram) @map("notification_channel")
  notificationCadence    NotificationCadence @default(immediate) @map("notification_cadence")
  /// Set by the 2C migration when old duration buckets were converted; cleared on the next save.
  durationReviewRequired Boolean             @default(false) @map("duration_review_required")
  isDemo                 Boolean             @default(false) @map("is_demo")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  criteria ProfileCriteria?
  versions SearchProfileVersion[]
  matches  JobProfileMatch[]

  @@index([enabled, archivedAt])
  @@map("search_profiles")
}

/// Matching criteria for a profile (1:1). Empty arrays mean "no constraint".
model ProfileCriteria {
  profileId               String                @id @map("profile_id")
  titleKeywords           String[]              @map("title_keywords")
  excludedTitleKeywords   String[]              @map("excluded_title_keywords")
  includeKeywords         String[]              @default([]) @map("include_keywords")
  excludeKeywords         String[]              @default([]) @map("exclude_keywords")
  disciplines             Discipline[]
  jobTypes                JobType[]             @map("job_types")
  durations               DurationRequirement[]
  provinces               Province[]
  arrangements            WorkArrangement[]
  includeRemoteCanadaWide Boolean               @default(true) @map("include_remote_canada_wide")
  experienceLevels        ExperienceLevel[]     @map("experience_levels")
  maxYearsExperience      Int?                  @map("max_years_experience")

  profile SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_criteria")
}

/// Immutable snapshot of a profile's settings at one version. Evaluations
/// reference the version they used, so history stays explainable after edits.
model SearchProfileVersion {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id")
  version   Int
  /// The full SearchProfileDraft (lib/types.ts) as saved.
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile SearchProfile     @relation(fields: [profileId], references: [id], onDelete: Restrict)
  matches JobProfileMatch[]

  @@unique([profileId, version])
  @@map("search_profile_versions")
}

/// Result of evaluating one job against all enabled profiles — at most one per
/// job, which is what makes notifications deduplicated.
model JobProfileEvaluation {
  jobId         String    @id @map("job_id")
  evaluatedAt   DateTime  @map("evaluated_at") @db.Timestamptz(3)
  /// Matching-rules version (lib/matching/engine.ts MATCHING_ENGINE_VERSION).
  engineVersion String    @map("engine_version")
  /// Set only once a notification has actually been sent.
  notifiedAt    DateTime? @map("notified_at") @db.Timestamptz(3)
  isDemo        Boolean   @default(false) @map("is_demo")

  job     JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matches JobProfileMatch[]

  @@map("job_profile_evaluations")
}

/// One profile that a job satisfied. `rank` 0 is the primary profile whose
/// automation mode governs the job.
model JobProfileMatch {
  jobId          String             @map("job_id")
  profileId      String             @map("profile_id")
  /// The profile version (criteria snapshot) this result was computed against.
  profileVersion Int                @map("profile_version")
  rank           Int
  status         ProfileMatchStatus
  /// 0–100 soft relevance (not the candidate-fit score); null without soft signals.
  relevance      Int?
  reasons        String[]

  evaluation JobProfileEvaluation @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  /// Restrict: a profile with match history cannot be hard-deleted (it is archived instead).
  profile    SearchProfile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  version    SearchProfileVersion @relation(fields: [profileId, profileVersion], references: [profileId, version], onDelete: Restrict)

  @@id([jobId, profileId])
  @@unique([jobId, rank])
  @@index([profileId])
  @@map("job_profile_matches")
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

enum PreparationStatus {
  not_started
  awaiting_approval
  queued
  generating
  ready_for_review
  failed

  @@map("preparation_status")
}

enum SubmissionStatus {
  not_submitted
  submitted
  interviewing
  offer
  rejected
  withdrawn

  @@map("submission_status")
}

/// One application per canonical job.
model Application {
  id                String            @id
  jobId             String            @unique @map("job_id")
  mode              ApplicationMode
  preparationStatus PreparationStatus @default(not_started) @map("preparation_status")
  submissionStatus  SubmissionStatus  @default(not_submitted) @map("submission_status")
  /// Recorded by the user. CHECK constraint ties this to submission_status.
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz(3)
  resumeId          String?           @unique @map("resume_id")
  coverLetterId     String?           @unique @map("cover_letter_id")
  projectId         String?           @map("project_id")
  notes             String            @default("")
  isDemo            Boolean           @default(false) @map("is_demo")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         JobPosting           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resume      ResumeArtifact?      @relation("SelectedResume", fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter CoverLetterArtifact? @relation("SelectedCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)

  events       ApplicationEvent[]
  interviews   ApplicationInterview[]
  runs         WorkflowRun[]
  resumes      ResumeArtifact[]       @relation("ApplicationResumes")
  coverLetters CoverLetterArtifact[]  @relation("ApplicationCoverLetters")

  @@index([preparationStatus])
  @@index([submissionStatus])
  @@index([updatedAt(sort: Desc)])
  @@map("applications")
}

enum ApplicationEventType {
  created
  mode_changed
  preparation_status_changed
  submission_status_changed
  submission_recorded
  artifact_linked
  note_updated
  interview_recorded
  submission_date_changed

  @@map("application_event_type")
}

enum InterviewStage {
  recruiter_screen
  technical
  take_home
  onsite
  final
  other

  @@map("interview_stage")
}

/// One interview stage the user recorded.
model ApplicationInterview {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id")
  stage         InterviewStage
  /// Calendar date (no time zone).
  occurredOn    DateTime       @map("occurred_on") @db.Date
  notes         String         @default("")
  isDemo        Boolean        @default(false) @map("is_demo")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredOn])
  @@map("application_interviews")
}

/// Append-only history for an application (a trigger rejects UPDATEs).
model ApplicationEvent {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @map("application_id")
  type          ApplicationEventType
  fromValue     String?              @map("from_value")
  toValue       String?              @map("to_value")
  message       String?
  occurredAt    DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  isDemo        Boolean              @default(false) @map("is_demo")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@map("application_events")
}

enum RunKind {
  resume
  cover_letter
  project
  full_build

  @@map("run_kind")
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("run_status")
}

/// One execution of a generation workflow (maps to `ApplicationRun` in lib/types.ts).
model WorkflowRun {
  id            String    @id
  applicationId String    @map("application_id")
  kind          RunKind
  status        RunStatus @default(queued)
  startedAt     DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  summary       String    @default("")
  errorMessage  String?   @map("error_message")
  isDemo        Boolean   @default(false) @map("is_demo")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, startedAt(sort: Desc)])
  @@index([status])
  @@map("workflow_runs")
}

// ---------------------------------------------------------------------------
// Generated artifacts
// ---------------------------------------------------------------------------

enum GenerationStatus {
  draft
  generating
  ready
  failed

  @@map("generation_status")
}

enum CoverLetterTone {
  formal
  conversational
  concise

  @@map("cover_letter_tone")
}

/// Metadata only; file contents will live in artifact storage (`storage_key`).
model ResumeArtifact {
  id                String           @id
  applicationId     String?          @map("application_id")
  jobId             String?          @map("job_id")
  version           String
  title             String
  generationStatus  GenerationStatus @default(draft) @map("generation_status")
  baseTemplate      String           @map("base_template")
  highlightedSkills String[]         @map("highlighted_skills")
  pageCount         Int?             @map("page_count")
  storageKey        String?          @map("storage_key")
  isDemo            Boolean          @default(false) @map("is_demo")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application? @relation("ApplicationResumes", fields: [applicationId], references: [id], onDelete: SetNull)
  job         JobPosting?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  selectedBy  Application? @relation("SelectedResume")

  @@unique([applicationId, version])
  @@index([jobId])
  @@index([createdAt(sort: Desc)])
  @@map("resume_artifacts")
}

model CoverLetterArtifact {
  id               String           @id
  applicationId    String?          @map("application_id")
  jobId            String?          @map("job_id")
  version          String
  title            String
  generationStatus GenerationStatus @default(draft) @map("generation_status")
  baseTemplate     String           @map("base_template")
  tone             CoverLetterTone
  wordCount        Int?             @map("word_count")
  storageKey       String?          @map("storage_key")
  isDemo           Boolean          @default(false) @map("is_demo")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application? @relation("ApplicationCoverLetters", fields: [applicationId], references: [id], onDelete: SetNull)
  job         JobPosting?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  selectedBy  Application? @relation("SelectedCoverLetter")

  @@unique([applicationId, version])
  @@index([jobId])
  @@index([createdAt(sort: Desc)])
  @@map("cover_letter_artifacts")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum CheckStatus {
  not_run
  pending
  passing
  failing

  @@map("check_status")
}

enum RepositoryVisibility {
  private
  public

  @@map("repository_visibility")
}

model Project {
  id             String               @id
  name           String
  description    String               @default("")
  technologies   String[]
  repoOwner      String               @map("repo_owner")
  repoName       String               @map("repo_name")
  repoVisibility RepositoryVisibility @default(private) @map("repo_visibility")
  /// Always false until GitHub publishing exists.
  repoPublished  Boolean              @default(false) @map("repo_published")
  repoUrl        String?              @map("repo_url")
  buildStatus    CheckStatus          @default(not_run) @map("build_status")
  testStatus     CheckStatus          @default(not_run) @map("test_status")
  isDemo         Boolean              @default(false) @map("is_demo")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobLinks     ProjectJob[]
  applications Application[]

  @@unique([repoOwner, repoName])
  @@map("projects")
}

/// Many-to-many: a project can support several jobs and vice versa.
model ProjectJob {
  projectId String   @map("project_id")
  jobId     String   @map("job_id")
  /// Order in which jobs are listed on the project.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job     JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([projectId, jobId])
  @@index([jobId])
  @@map("project_jobs")
}

// ---------------------------------------------------------------------------
// Approvals (future Telegram decisions)
// ---------------------------------------------------------------------------

enum ApprovalChannel {
  telegram
  dashboard

  @@map("approval_channel")
}

enum ApprovalDecision {
  pending
  full_build
  quick_apply
  skip
  expired

  @@map("approval_decision")
}

/// A request for a Full Build / Quick Apply / Skip decision. A partial unique
/// index (migration SQL) allows at most one *pending* request per job.
model ApprovalRequest {
  id                String           @id
  jobId             String           @map("job_id")
  channel           ApprovalChannel
  decision          ApprovalDecision @default(pending)
  requestedAt       DateTime         @map("requested_at") @db.Timestamptz(3)
  respondedAt       DateTime?        @map("responded_at") @db.Timestamptz(3)
  /// Telegram identifiers, populated once the bot exists.
  telegramChatId    String?          @map("telegram_chat_id")
  telegramMessageId String?          @map("telegram_message_id")
  isDemo            Boolean          @default(false) @map("is_demo")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([decision, requestedAt(sort: Desc)])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Employer boards (ATS registry). Polling is not implemented yet.
// ---------------------------------------------------------------------------

/// One public job board for one employer on one ATS provider.
/// Duplicate registrations are prevented by unique (provider, board_token) and
/// unique board_url; CHECK constraints in the migration keep tokens lowercase and
/// restrict providers to ATS types.
model EmployerBoard {
  id                  String         @id @default(uuid()) @db.Uuid
  provider            SourceProvider
  employerName        String         @map("employer_name")
  /// Provider-specific board identifier, stored lowercase.
  boardToken          String         @map("board_token")
  /// Canonical public URL derived from provider + token (lib/boards/board-url.ts).
  boardUrl            String         @unique @map("board_url")
  enabled             Boolean        @default(true)
  pollIntervalMinutes Int            @default(360) @map("poll_interval_minutes")
  lastCheckedAt       DateTime?      @map("last_checked_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime?      @map("last_success_at") @db.Timestamptz(3)
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  lastErrorAt         DateTime?      @map("last_error_at") @db.Timestamptz(3)
  lastErrorMessage    String?        @map("last_error_message")
  /// Machine-readable code of the last failure (AtsError code); drives retry policy.
  lastErrorCode       String?        @map("last_error_code")
  /// When the background worker should next sync this board. Null = not scheduled
  /// (disabled, demo, or paused after a permanent configuration error).
  nextSyncAt          DateTime?      @map("next_sync_at") @db.Timestamptz(3)
  /// Worker lease: which worker claimed the board and until when (crash recovery).
  syncLeaseOwner      String?        @map("sync_lease_owner")
  syncLeaseExpiresAt  DateTime?      @map("sync_lease_expires_at") @db.Timestamptz(3)
  /// Provider data region; only Lever "eu" (jobs.eu.lever.co / api.eu.lever.co) today. Null = default region.
  region              String?
  /// How the board was added: by the user, or by automatic discovery (Milestone 3C).
  origin              BoardOrigin    @default(manual)
  /// Employer this board belongs to, when established (discovery sets it from verified evidence).
  companyId           String?        @map("company_id") @db.Uuid
  isDemo              Boolean        @default(false) @map("is_demo")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  source       JobSource           @relation(fields: [provider], references: [provider], onDelete: Restrict)
  company      Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  observations SourceObservation[]
  syncRuns     BoardSyncRun[]
  discovery    DiscoveryCandidate?

  @@unique([provider, boardToken])
  @@index([enabled, lastCheckedAt])
  @@index([nextSyncAt])
  @@index([companyId])
  @@map("employer_boards")
}

// ---------------------------------------------------------------------------
// Settings (single user; one row with id 'default', enforced by CHECK)
// ---------------------------------------------------------------------------

/// Defaults for new search profiles and applications, plus global switches.
/// Search profiles remain the source of truth for matching; these values only
/// pre-fill new profiles, so they never conflict with saved profiles.
model UserSettings {
  id                         String                @id @default("default")
  /// Optimistic concurrency.
  version                    Int                   @default(1)
  provinces                  Province[]
  arrangements               WorkArrangement[]
  jobTypes                   JobType[]             @map("job_types")
  durations                  DurationRequirement[]
  disciplines                Discipline[]
  includeRemoteCanadaWide    Boolean               @default(true) @map("include_remote_canada_wide")
  /// Global pause: no notifications for any profile while true.
  notificationsPaused        Boolean               @default(false) @map("notifications_paused")
  defaultNotificationCadence NotificationCadence   @default(immediate) @map("default_notification_cadence")
  defaultApplicationMode     ApplicationMode       @default(quick_apply) @map("default_application_mode")
  defaultAutomationMode      AutomationMode        @default(approval_required) @map("default_automation_mode")
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// Board synchronization (Milestone 3A; manually triggered, no scheduler)
// ---------------------------------------------------------------------------

/// What a provider's publication timestamp means. Only `first_published`
/// supports a publication-to-discovery latency.
enum PublishedAtKind {
  none
  first_published
  last_published
  updated

  @@map("published_at_kind")
}

enum SyncRunStatus {
  running
  succeeded
  /// Finished, but the catalogue was incomplete or some postings failed; nothing was expired.
  partial
  failed
  /// Not run (e.g. another sync of the board was already running).
  skipped

  @@map("sync_run_status")
}

enum SyncTrigger {
  manual
  scheduled

  @@map("sync_trigger")
}

/// One synchronization of one employer board. A partial unique index allows at
/// most one `running` run per board (prevents concurrent syncs).
model BoardSyncRun {
  id           String        @id @default(uuid()) @db.Uuid
  boardId      String        @map("board_id") @db.Uuid
  status       SyncRunStatus @default(running)
  trigger      SyncTrigger   @default(manual)
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?     @map("finished_at") @db.Timestamptz(3)
  durationMs   Int?          @map("duration_ms")
  /// Postings returned by the provider.
  fetched      Int           @default(0)
  created      Int           @default(0)
  updated      Int           @default(0)
  unchanged    Int           @default(0)
  /// Postings newly marked inactive (absent from two consecutive complete snapshots).
  closed       Int           @default(0)
  /// Previously inactive postings listed again.
  reactivated  Int           @default(0)
  /// Active postings absent from this complete snapshot (not yet inactive).
  missing      Int           @default(0)
  /// Whether the provider returned a provably complete catalogue (null while running).
  complete     Boolean?
  /// Not Canadian, or not an internship / co-op / new-grad / junior role
  /// (= filteredLocation + filteredEmploymentType; kept for older runs and the UI).
  skipped      Int           @default(0)
  /// Postings that passed the Canadian location and employment-type filters.
  eligible               Int @default(0)
  filteredLocation       Int @default(0) @map("filtered_location")
  filteredEmploymentType Int @default(0) @map("filtered_employment_type")
  /// Eligible postings recorded as another sighting of a job already known from another source.
  duplicate              Int @default(0)
  /// Provider items dropped as unreadable (no id/title); NOT included in `fetched`.
  invalid                Int @default(0)
  /// Eligible postings that could not be saved.
  ingestErrors           Int @default(0) @map("ingest_errors")
  /// Secondary diagnostic: eligible postings whose description is missing or incomplete.
  enrichmentIncomplete   Int @default(0) @map("enrichment_incomplete")
  errorCount   Int           @default(0) @map("error_count")
  errorCode    String?       @map("error_code")
  errorMessage String?       @map("error_message")
  /// Per-posting problems and skip reasons (bounded).
  details      Json?

  board EmployerBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, startedAt(sort: Desc)])
  @@map("board_sync_runs")
}

// ---------------------------------------------------------------------------
// Milestone 3C: companies and automatic board discovery
// ---------------------------------------------------------------------------

enum BoardOrigin {
  manual
  discovered

  @@map("board_origin")
}

/// An employer. Identified by its VERIFIED website domain when known; companies
/// are never merged by name similarity.
model Company {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  /// Lowercase host without "www.", set only from verified ownership evidence.
  domain    String?       @unique
  origin    BoardOrigin   @default(discovered)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  boards EmployerBoard[]

  @@map("companies")
}

enum DiscoveryCandidateStatus {
  discovered
  validating
  verified
  pending_review
  rejected
  registered

  @@map("discovery_candidate_status")
}

enum DiscoverySource {
  search
  common_crawl
  existing_jobs
  manual

  @@map("discovery_source")
}

enum DiscoveryEvidenceType {
  /// The provider's public API returned a valid board.
  ats_board_response
  /// The company's website links to this board (ownership evidence).
  official_site_link
  /// The company's careers page redirects to this board (ownership evidence).
  official_site_redirect
  /// A search query surfaced the board (never ownership evidence; no result content stored).
  search_result
  /// A Common Crawl URL-index row (historical; never ownership evidence).
  common_crawl
  /// A job the user saved points at this board (never ownership evidence).
  existing_job_url
  /// The board was already registered.
  existing_board
  /// A person approved or rejected the candidate.
  manual_review

  @@map("discovery_evidence_type")
}

enum DiscoveryEvidenceStatus {
  validated
  unvalidated
  failed

  @@map("discovery_evidence_status")
}

/// One possible ATS board, unique by (provider, board token).
model DiscoveryCandidate {
  id                String                   @id @default(uuid()) @db.Uuid
  provider          SourceProvider
  /// Lowercase board identifier (lib/boards/board-url.ts).
  boardToken        String                   @map("board_token")
  region            String?
  /// Canonical public board URL.
  boardUrl          String                   @map("board_url")
  companyName       String?                  @map("company_name")
  /// Candidate website domain; trusted only when an ownership evidence row is validated.
  companyDomain     String?                  @map("company_domain")
  /// URL as first observed (canonical board URL for search results, which are not stored).
  discoveredUrl     String                   @map("discovered_url")
  source            DiscoverySource
  status            DiscoveryCandidateStatus @default(discovered)
  statusReason      String?                  @map("status_reason")
  /// Verification attempts that ended in a temporary failure (bounded retries).
  attempts          Int                      @default(0)
  nextAttemptAt     DateTime?                @map("next_attempt_at") @db.Timestamptz(3)
  /// Lease while a worker verifies this candidate (crash recovery).
  validatingUntil   DateTime?                @map("validating_until") @db.Timestamptz(3)
  lastVerifiedAt    DateTime?                @map("last_verified_at") @db.Timestamptz(3)
  /// Published postings when the board was last validated.
  postingCount      Int?                     @map("posting_count")
  firstDiscoveredAt DateTime                 @map("first_discovered_at") @db.Timestamptz(3)
  lastDiscoveredAt  DateTime                 @map("last_discovered_at") @db.Timestamptz(3)
  registeredBoardId String?                  @unique @map("registered_board_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  registeredBoard EmployerBoard?      @relation(fields: [registeredBoardId], references: [id], onDelete: SetNull)
  evidence        DiscoveryEvidence[]

  @@unique([provider, boardToken])
  @@index([status, nextAttemptAt])
  @@map("discovery_candidates")
}

model DiscoveryEvidence {
  id          String                  @id @default(uuid()) @db.Uuid
  candidateId String                  @map("candidate_id") @db.Uuid
  type        DiscoveryEvidenceType
  status      DiscoveryEvidenceStatus
  sourceUrl   String?                 @map("source_url")
  /// Deduplicates repeated observations of the same evidence.
  dedupeKey   String                  @map("dedupe_key")
  observedAt  DateTime                @map("observed_at") @db.Timestamptz(3)
  /// Small extracted facts (never search-result titles or snippets).
  metadata    Json?
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  candidate DiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, dedupeKey])
  @@map("discovery_evidence")
}

enum DiscoveryRunStatus {
  running
  succeeded
  partial
  failed

  @@map("discovery_run_status")
}

model DiscoveryRun {
  id               String             @id @default(uuid()) @db.Uuid
  /// Sources this run collected from, e.g. "search,existing_jobs" or "common_crawl".
  source           String
  trigger          SyncTrigger
  status           DiscoveryRunStatus @default(running)
  startedAt        DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?          @map("finished_at") @db.Timestamptz(3)
  searchRequests   Int                @default(0) @map("search_requests")
  searchProvider   String?            @map("search_provider")
  searchCredits    Int                @default(0) @map("search_credits")
  candidateUrls    Int                @default(0) @map("candidate_urls")
  uniqueCandidates Int                @default(0) @map("unique_candidates")
  newCandidates    Int                @default(0) @map("new_candidates")
  validated        Int                @default(0)
  registered       Int                @default(0)
  pendingReview    Int                @default(0) @map("pending_review")
  rejected         Int                @default(0)
  apiErrors        Int                @default(0) @map("api_errors")
  atsRequests      Int                @default(0) @map("ats_requests")
  siteRequests     Int                @default(0) @map("site_requests")
  errorMessage     String?            @map("error_message")
  details          Json?

  @@index([startedAt(sort: Desc)])
  @@index([searchProvider, startedAt(sort: Desc)])
  @@map("discovery_runs")
}

/// Evolving registry of search queries and how well each performs.
model DiscoveryQuery {
  id            String          @id @default(uuid()) @db.Uuid
  provider      SourceProvider
  category      String
  text          String          @unique
  runs          Int             @default(0)
  results       Int             @default(0)
  newCandidates Int             @default(0) @map("new_candidates")
  verified      Int             @default(0)
  requests      Int             @default(0)
  /// Next result page offset (Brave allows 0–9).
  nextOffset    Int             @default(0) @map("next_offset")
  exhausted     Boolean         @default(false)
  lastRunAt     DateTime?       @map("last_run_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([lastRunAt])
  @@map("discovery_queries")
}

/// Single-row durable schedule + lease for discovery runs (same pattern as board sync).
model DiscoverySchedule {
  id             String    @id
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(3)
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  /// Set by "Run discovery now"; picked up by the worker.
  requestedAt    DateTime? @map("requested_at") @db.Timestamptz(3)
  lastRunId      String?   @map("last_run_id") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("discovery_schedule")
}
